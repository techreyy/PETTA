DATABASE_URI=postgresql://USER:PASSWORD@127.0.0.1:5432/petta
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Required for production media (S3, R2, MinIO).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only configure a header that your reverse proxy OVERWRITES, never forwards blindly.
CONTACT_TRUSTED_IP_HEADER=
