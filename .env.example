# Database configuration
# For local development:
DATABASE_URI=postgresql://USER:***@127.0.0.1:5432/petta
# For Neon / Cloud PostgreSQL production (use ?sslmode=verify-full for strict, warning-free TLS):
# DATABASE_URI=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Production Media Storage (Cloudflare R2 / S3 compatible)
# Note: Cloudflare R2 requires region=auto and forcePathStyle=true (configured automatically).
# Endpoint must include https:// without trailing slash and without bucket name.
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only configure a header that your reverse proxy OVERWRITES, never forwards blindly.
CONTACT_TRUSTED_IP_HEADER=
